# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=2567
# HMAC key for anonymous guest tokens. Use a long random value in production.
GUEST_TOKEN_SECRET=dev-only-change-me-0000000000000000
# Comma-separated list of allowed browser origins for the HTTP API.
ALLOWED_ORIGINS=http://localhost:5173
# Set to 1 when a reverse proxy such as Caddy sits in front of the server, so rate limits use
# the real client address from X-Forwarded-For. Leave unset when clients connect directly.
TRUST_PROXY=
# Optional. Directory of the built web client to serve from the same port.
# Defaults to apps/web/dist when that build exists.
WEB_DIST=
# Optional. Set to debug for verbose server logs, including health checks.
LOG_LEVEL=info
# PostgreSQL arrives in Milestone E. Left here so the deployment shape is stable.
DATABASE_URL=postgres://bolt:bolt@localhost:5432/bolt
