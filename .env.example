# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=2567
# HMAC key for anonymous guest tokens. Use a long random value in production.
GUEST_TOKEN_SECRET=dev-only-change-me-0000000000000000
# Comma-separated list of allowed browser origins for the HTTP API.
ALLOWED_ORIGINS=http://localhost:5173
# PostgreSQL arrives in Milestone E. Left here so the deployment shape is stable.
DATABASE_URL=postgres://bolt:bolt@localhost:5432/bolt
