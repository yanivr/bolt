{
  "name": "@bolt/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@bolt/shared=../../packages/shared/src/index.ts --alias:@bolt/content=../../packages/content/src/index.ts --outfile=dist/main.js --sourcemap",
    "start": "node --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@bolt/content": "workspace:*",
    "@bolt/shared": "workspace:*",
    "@colyseus/core": "0.16.26",
    "@colyseus/schema": "3.0.76",
    "@colyseus/ws-transport": "0.16.5",
    "colyseus": "0.16.5",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "pg": "8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/pg": "8.11.10",
    "colyseus.js": "0.16.22",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6"
  }
}
